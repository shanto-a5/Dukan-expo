{
  "expo": {
    "name": "Dukan",
    "slug": "samrat-dukan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vantaseller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kader95.vantaseller"
    },
    "android": {
      "icon": "./assets/images/dukan-android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dukan-android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kader95.vantaseller",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-image",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1a9e021f-cd5e-445a-a07b-eebadd7754eb"
      }
    }
  }
}
